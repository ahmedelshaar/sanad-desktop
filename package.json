{
  "name": "sanad-desktop",
  "productName": "Sanad",
  "version": "0.2.0",
  "description": "برنامج سندات لأمر — Promissory notes desktop app",
  "author": "Eleva Pro Technology <elshaar@eleva-protech.com> (https://eleva-protech.com)",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "node scripts/check-license-config.cjs && vite build && node scripts/harden.cjs && electron-builder --win --x64",
    "test": "node --test tests/*.test.*",
    "dist:zip": "node scripts/check-license-config.cjs && vite build && node scripts/harden.cjs && electron-builder --win zip --x64",
    "test:e2e": "vite build && node --test --test-concurrency=1 e2e/*.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "harden": "node scripts/harden.cjs",
    "test:e2e:hardened": "vite build && node scripts/harden.cjs && cross-env SANAD_E2E_APP=.harden node --test --test-concurrency=1 e2e/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^5.10.1",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.elevaprotech.sanad",
    "productName": "Sanad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": ".harden/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Sanad - سندات",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "electron/assets/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "asar": true
  },
  "homepage": "https://eleva-protech.com"
}
